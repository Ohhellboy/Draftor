        {
          "field": "composition_revision",
          "nonzero": true,
          "when": {
            "source": "envelope",
            "field": "composition_id",
            "nonzero": true
          }
        },
        {
          "field": "candidate_snapshot_id",
          "nonzero": true,
          "when": {
            "source": "payload",
            "field": "candidate_valid",
            "equals": 1
          }
        }
      ],
      "producer_responsibility": "Integration layer supplies the complete current structure; zero composition identity means no active composition. Candidate identity is meaningful only when candidate_valid=1. InputScheme and EditContext are caller facts; neither is inferred from BaseInputMode or RouteTarget."
