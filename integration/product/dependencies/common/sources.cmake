set(DRAFTOR_COMMON "${CMAKE_CURRENT_LIST_DIR}")
set(DRAFTOR_CORE_SOURCES
 document.cpp body_editor.cpp body_key_repeat.cpp utf8.cpp input_router.cpp
 layout.cpp visual_cursor_navigator.cpp selection_highlight.cpp
 hanime_document_editor_port.cpp core_runtime.cpp)
list(TRANSFORM DRAFTOR_CORE_SOURCES PREPEND "${DRAFTOR_COMMON}/")
file(GLOB DRAFTOR_DOCUMENT_SOURCES CONFIGURE_DEPENDS "${DRAFTOR_COMMON}/src/hanime_document/*.cpp")
list(FILTER DRAFTOR_DOCUMENT_SOURCES EXCLUDE REGEX "/file_manager_model.cpp$")
list(APPEND DRAFTOR_CORE_SOURCES ${DRAFTOR_DOCUMENT_SOURCES})
set(DRAFTOR_FIND_SOURCES find_session.cpp find_input.cpp find_controller.cpp find_highlight.cpp find_view_model.cpp hanime_document_adapter.cpp)
list(TRANSFORM DRAFTOR_FIND_SOURCES PREPEND "${DRAFTOR_COMMON}/")
function(draftor_configure target minimal find stats)
 target_sources(${target} PRIVATE ${DRAFTOR_CORE_SOURCES})
 if(find)
  target_sources(${target} PRIVATE ${DRAFTOR_FIND_SOURCES})
 endif()
 if(stats)
  target_sources(${target} PRIVATE "${DRAFTOR_COMMON}/text_stats.cpp")
 endif()
 target_include_directories(${target} PUBLIC "${DRAFTOR_COMMON}")
 target_compile_features(${target} PUBLIC cxx_std_17)
 target_compile_options(${target} PRIVATE $<$<COMPILE_LANGUAGE:CXX>:-Wall;-Wextra;-Wpedantic;-Werror>)
 target_compile_definitions(${target} PUBLIC DRAFTOR_MINIMAL=${minimal} DRAFTOR_ENABLE_FIND=${find} DRAFTOR_ENABLE_STATS=${stats} HANIME_SAVE_SUBSTAGE_DIAGNOSTIC=0)
 if(minimal)
  target_compile_definitions(${target} PUBLIC HANIME_METADATA_CACHE_ENTRIES=0)
 else()
  target_compile_definitions(${target} PUBLIC HANIME_METADATA_CACHE_ENTRIES=128)
 endif()
endfunction()
