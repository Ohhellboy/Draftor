{
  "name": "draftor-web-installer-r1",
  "version": "1.0.0-software",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "verify:release": "node tools/verify-release.mjs",
    "build:r13-public": "node tools/build-r13-public.mjs",
    "build:r12-public": "node tools/build-with-project-pages.mjs r12-public",
    "build": "node tools/build-with-project-pages.mjs default",
    "build:device-test": "node tools/build.mjs --device-test-update",
    "build:r6-locked": "node tools/build.mjs --r6-locked",
    "build:first-install-test": "node tools/build.mjs --device-test-first-install",
    "test:r6": "node --test tests/r6-first-install.test.mjs tests/rom-status.test.mjs",
    "preview": "node tools/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "check": "npm run verify:release && npm test && npm run build && npm run test:browser"
  },
  "dependencies": { "esptool-js": "0.7.1", "spark-md5": "3.0.2" },
  "devDependencies": { "esbuild": "0.25.12", "@playwright/test": "1.56.1" }
}
